{
  "name": "dsh-netease-music",
  "version": "0.1.0",
  "private": true,
  "description": "DSH 网易云音乐播放插件（直连模式）：每日推荐 / 我的歌单 / 音质选择 / 歌词。零第三方依赖，不经本地 API 服务。",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-runtime"
      ]
    }
  },
  "dependencies": {},
  "license": "MIT",
  "files": [
    "lib/index.js",
    "lib/client.js",
    "vendor/qr.mjs",
    "cordis.patch.yml",
    "THIRD-PARTY-NOTICES.md",
    "LICENSE"
  ]
}
